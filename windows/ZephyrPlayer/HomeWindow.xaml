<Window x:Class="ZephyrPlayer.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#1B1B1E" Icon="/ZephyrPlayer;component/assets/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="#1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Background="#1B1B1E" Margin="8,12,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button Content="Movies" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"/>
        <Button Grid.Row="2" Style="{StaticResource GhostButton}" x:Name="PhoneCard" Content="Paired phones" Click="OnPairing" HorizontalContentAlignment="Left"/>
        <Button Grid.Row="3" Style="{StaticResource GhostButton}" Content="Settings" Click="OnSettings" HorizontalContentAlignment="Left"/>
      </Grid>
      <Grid Grid.Column="1" Background="#232328">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: app identity + settings gear -->
        <Border Grid.Row="0" Background="#141417" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/ZephyrPlayer;component/assets/icon.ico" Width="26" Height="26"/>
                    <TextBlock Text="Movies" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0"/>
                </StackPanel>
                <Button x:Name="SortButton" Style="{StaticResource GhostButton}" Content="Sort: Name" HorizontalAlignment="Right" Margin="0,0,140,0" Click="OnSort"/>
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,3 H15 L16,7 L20,8 V16 L16,17 L15,21 H9 L8,17 L4,16 V8 L8,7 Z M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text=" Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,16">
            <!-- Empty state: no movies folder chosen yet -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="28" Height="28"><Path Data="M4.96,21.62 L4.96,6.86 L12.57,6.86 L14.48,9.24 L23.04,9.24 L23.04,21.62 Z M4.96,11.62 L23.04,11.62" Stroke="{StaticResource OrangeBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                <TextBlock Text="Pick your movies folder" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="Choose the folder you want to browse." Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Style="{StaticResource OrangeButton}" Content="Choose movies folder" Click="OnBrowseFolder" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Explorer view -->
            <Grid x:Name="LibraryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: back / up + clickable breadcrumb + search -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="Back" FontSize="15" Click="OnBack" ToolTip="Back"/>
                    <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Up" FontSize="15" Click="OnUp" ToolTip="Up one folder" Margin="2,0,0,0"/>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Choose folder" Click="OnBrowseFolder" ToolTip="Change movies folder"/>
                            <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Same 10px rounding as the address bar next to it (review nit 6). -->
                    <Border Grid.Column="3" Width="220" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource CardBrush}" CornerRadius="10">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="10,6" FontSize="13" VerticalContentAlignment="Center"
                                     TextChanged="OnSearchChanged"/>
                            <TextBlock x:Name="SearchHint" Text="Search Movies" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Large-icons grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ListBox x:Name="MovieList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="OnEntryOpen" KeyDown="OnEntryKey">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="202" Margin="0,0,25,20">
                                        <Border Width="202" Height="126" Background="{StaticResource CardBrush}" CornerRadius="10" BorderBrush="#12FFFFFF" BorderThickness="1" Visibility="{Binding FolderVis}">
                                          <Viewbox Width="140" Height="114"><Grid Width="140" Height="114">
                                            <Image Source="{Binding Peek}" Width="122" Height="65" Margin="0,28,0,0" Stretch="UniformToFill"/>
                                            <Path Data="M7,105 V17 Q7,8 16,8 H49 Q55,8 59,14 L67,23 H124 Q133,23 133,31 V105 Q133,109 128,109 H12 Q7,109 7,105 Z M7,40 H133" Stroke="#FF9500" StrokeThickness="2.6" StrokeLineJoin="Round" Fill="{x:Null}"/>
                                          </Grid></Viewbox>
                                        </Border>
                                        <Border Width="202" Height="126" Background="#141417" CornerRadius="10" ClipToBounds="True" Visibility="{Binding FileVis}">
                                          <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13"
                                                   TextAlignment="Left" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tile" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource Card2Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyFolderText" Text="This folder is empty." Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="8,10" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="#141417" Padding="20,8">
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Border>
      </Grid>
    </Grid>
</Window>
