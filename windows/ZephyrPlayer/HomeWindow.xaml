<Window x:Class="ZephyrPlayer.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#0B0B0D" Icon="/ZephyrPlayer;component/assets/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
      <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <!-- Top tabs: quiet text, orange underline on the current one. -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="6,3"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"/>
        <Style x:Key="TileItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
      </ResourceDictionary>
    </Window.Resources>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- Top bar: tabs, search, phone status. One row, nothing else competes. -->
      <Grid Grid.Row="0" Margin="20,14,20,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Grid><Button x:Name="LibraryTab" Style="{StaticResource TabButton}" Content="Library" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/><Border Height="2" CornerRadius="1" Background="{StaticResource OrangeBrush}" VerticalAlignment="Bottom" Margin="14,0,14,0" IsHitTestVisible="False"/></Grid>
          <Button x:Name="PhonesTab" Style="{StaticResource TabButton}" Content="Phones" Click="OnPairing"/>
          <Button x:Name="SettingsButton" Style="{StaticResource TabButton}" Content="Settings" Click="OnSettings"/>
        </StackPanel>
        <Border Grid.Column="2" Width="260" Height="34" Margin="0,0,12,0" Background="{StaticResource PanelBrush}" BorderThickness="1" CornerRadius="10">
          <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource PanelLineBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid>
            <Path Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 1 0 10.5,3 M16,16 L21,21" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="34,6,10,6" FontSize="13" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
            <TextBlock x:Name="SearchHint" Text="Search library" Foreground="{StaticResource MutedBrush}" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="34,0,0,0"/>
          </Grid>
        </Border>
        <Button x:Name="PhoneCard" Grid.Column="3" Click="OnPairing" Height="34" Padding="14,0" Background="{StaticResource PanelBrush}">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="PhoneConnectedDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/><TextBlock x:Name="PhoneCardName" Text="Pair a phone" FontSize="13" VerticalAlignment="Center"/><TextBlock x:Name="PhoneCardStatus" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="28,10,28,0">
        <!-- Empty state: no movies folder chosen yet -->
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Viewbox Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="28" Height="28"><Path Data="M4.96,21.62 L4.96,6.86 L12.57,6.86 L14.48,9.24 L23.04,9.24 L23.04,21.62 Z M4.96,11.62 L23.04,11.62" Stroke="{StaticResource OrangeBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
          <TextBlock Text="Pick your movies folder" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
          <TextBlock Text="Choose the folder you want to browse." Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <Button Style="{StaticResource OrangeButton}" Content="Choose movies folder" Click="OnBrowseFolder" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid x:Name="LibraryView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <!-- Continue watching: the last few unfinished movies. Hidden when there are none. -->
          <StackPanel x:Name="ContinueStrip" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="CONTINUE WATCHING" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ItemsControl x:Name="ContinueList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="OnContinue" Tag="{Binding Path}" Margin="0,0,12,0" Padding="14,8" MinWidth="170" MaxWidth="280" Background="{StaticResource PanelBrush}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Left}" Foreground="{StaticResource OrangeBrush}" FontSize="12" Margin="0,2,0,5"/>
                    <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource OrangeBrush}" Background="#2A2A31" BorderThickness="0"/></StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Where you are: back, up, crumbs on the left; count and sort on the right. -->
          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Click="OnBack" ToolTip="Back" AutomationProperties.Name="Back"><Path Data="M16,4 L8,12 L16,20 M8,12 H23" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
              <Button x:Name="UpButton" Style="{StaticResource GhostButton}" Click="OnUp" ToolTip="Up one folder" AutomationProperties.Name="Up one folder"><Path Data="M4,16 L12,8 L20,16 M12,8 V23" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
              <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center" Margin="6,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
              <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource GhostButton}" Click="OnBrowseFolder" ToolTip="Change movies folder" Content="Change folder" FontSize="13"/>
              <Button Style="{StaticResource GhostButton}" Click="OnRefresh" ToolTip="Refresh" AutomationProperties.Name="Refresh"><Path Data="M20,8 A8,8 0 1 0 20,17 M20,8 H14 M20,8 V2" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Button>
              <Button x:Name="SortButton" Style="{StaticResource GhostButton}" Content="Sort: Name" Click="OnSort" FontSize="13"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <ListBox x:Name="MovieList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnEntryOpen" KeyDown="OnEntryKey">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid Width="204">
                  <!-- Folder: a compact card, icon and name side by side. -->
                  <Border Height="64" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelLineBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding FolderVis}">
                    <Grid Margin="16,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Path Data="M3,18 V6 Q3,4 5,4 H9.5 L12,7 H19 Q21,7 21,9 V18 Q21,20 19,20 H5 Q3,20 3,18 Z" Stroke="#C9C9D1" StrokeThickness="1.5" StrokeLineJoin="Round" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FF9500" CornerRadius="8" Width="18" Height="18" Visibility="{Binding WatchedVis}" ToolTip="Watched"><Path Data="M4,9 L7,12 L14,5" Stroke="#1B1B1E" StrokeThickness="2" Margin="1"/></Border>
                    </Grid>
                  </Border>
                  <!-- Video: a 16:9 picture with length and progress, name and details under it. -->
                  <StackPanel Visibility="{Binding FileVis}">
                    <Border Height="115" Background="#141417" CornerRadius="12" ClipToBounds="True">
                      <Grid><Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                        <Border Background="#CC0B0B0D" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Visibility="{Binding DurationVis}"><TextBlock Text="{Binding Duration}" Foreground="#F5F5F7" FontSize="11" FontWeight="SemiBold"/></Border>
                        <ProgressBar Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource OrangeBrush}" Background="#33FFFFFF" BorderThickness="0" Visibility="{Binding ProgressVis}"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,2,2,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyFolderText" Text="This folder is empty." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="8,10" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Grid>

      <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="28,6,28,12"/>
    </Grid>
</Window>
