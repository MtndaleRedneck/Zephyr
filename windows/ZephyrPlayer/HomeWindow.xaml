<Window x:Class="ZephyrPlayer.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player" Width="1280" Height="800" MinWidth="900" MinHeight="600"
        Background="#1B1B1E" Icon="/ZephyrPlayer;component/assets/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#26262D"/>
        <SolidColorBrush x:Key="Card2Brush" Color="#2E2E36"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9696A0"/>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="#1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: app identity + settings gear -->
        <Border Grid.Row="0" Background="#141417" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/ZephyrPlayer;component/assets/icon.ico" Width="26" Height="26"/>
                    <TextBlock Text="Zephyr Player" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text=" Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24,16">
            <!-- Empty state: no movies folder chosen yet -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="28" Height="28"><Path Data="M4.96,21.62 L4.96,6.86 L12.57,6.86 L14.48,9.24 L23.04,9.24 L23.04,21.62 Z M4.96,11.62 L23.04,11.62" Stroke="{StaticResource OrangeBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{x:Null}"/></Canvas></Viewbox>
                <TextBlock Text="Pick your movies folder" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="Your designated folder lives in Settings." Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Style="{StaticResource OrangeButton}" Content="Open Settings" Click="OnSettings" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Explorer view -->
            <Grid x:Name="LibraryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: back / up + clickable breadcrumb + search -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="&#x2190;" FontSize="15" Click="OnBack" ToolTip="Back"/>
                    <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="&#x2191;" FontSize="15" Click="OnUp" ToolTip="Up one folder" Margin="2,0,0,0"/>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Same 10px rounding as the address bar next to it (review nit 6). -->
                    <Border Grid.Column="3" Width="220" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource CardBrush}" CornerRadius="10">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" Padding="10,6" FontSize="13" VerticalContentAlignment="Center"
                                     TextChanged="OnSearchChanged"/>
                            <TextBlock x:Name="SearchHint" Text="Search Movies" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Large-icons grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ListBox x:Name="MovieList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="OnEntryOpen" KeyDown="OnEntryKey">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="124" Margin="6,6">
                                        <!-- Folder tile: poster peeking out of the wireframe outline -->
                                        <Grid Width="104" Height="88" Visibility="{Binding FolderVis}">
                                            <!-- Peeks INSIDE the folder outline's width, above its front flap
                                                 (round-3 P7); RectangleGeometry clip rounds the corners
                                                 (ClipToBounds ignores CornerRadius). -->
                                            <Border Width="44" Height="30" Margin="0,0,0,24"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,44,30" RadiusX="3" RadiusY="3"/>
                                                </Border.Clip>
                                                <Image Source="{Binding Peek}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Viewbox Width="96" Height="80" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <Canvas Width="28" Height="28">
                                                    <Path Data="M4.96,21.62 L4.96,6.86 L12.57,6.86 L14.48,9.24 L23.04,9.24 L23.04,21.62 Z M4.96,11.62 L23.04,11.62"
                                                          Stroke="{StaticResource OrangeBrush}" StrokeThickness="1" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="#1B1B1E"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <!-- File tile: film-strip frame around the real shell thumbnail -->
                                        <Border Width="104" Height="88" Background="#141417" CornerRadius="6" Padding="7,6" Visibility="{Binding FileVis}">
                                            <Grid>
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                    <Rectangle Width="3" Height="3" RadiusX="1" RadiusY="1" Fill="#2E2E36" Margin="0,1.4"/>
                                                </StackPanel>
                                                <!-- Placeholder play glyph sits BEHIND the thumbnail; the
                                                     real frame covers it once loaded. -->
                                                <Path Data="M0,0 L12,7 L0,14 Z" Fill="{StaticResource OrangeBrush}" Stretch="Uniform"
                                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" Margin="7,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tile" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource Card2Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyFolderText" Text="This folder is empty." Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" Margin="8,10" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="#141417" Padding="20,8">
            <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
