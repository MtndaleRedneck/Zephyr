<UserControl x:Class="ZephyrPlayer.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZephyrPlayer"
        x:Name="Root" Background="#060607" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F7"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Home / Library (approved render 01). A view inside the one ShellWindow. -->
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:RoundedClipConverter x:Key="RoundedClip"/>

        <!-- App-bar nav pill: 36 px, padding 0 14, radius 8, 13.5 px Medium #C4C4CC.
             Selected (Tag=sel): #F5F5F7 text, 7 % fill, 3 px #FF9500 underline 8 px below. -->
        <Style x:Key="NavPill" TargetType="Button">
            <Setter Property="Foreground" Value="#C4C4CC"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Height="36" CornerRadius="8" Padding="14,0" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Height="3" CornerRadius="1.5" Background="#FF9500" VerticalAlignment="Bottom" Margin="14,0,14,-8" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#0BFFFFFF"/><Setter Property="Foreground" Value="#E6E6EB"/></Trigger>
                            <Trigger Property="Tag" Value="sel"><Setter TargetName="Bg" Property="Background" Value="#12FFFFFF"/><Setter TargetName="Underline" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#F5F5F7"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#17FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 32 px boxed icon button (Back / Up / Refresh): 5 % fill, 6 % border, radius 8. -->
        <Style x:Key="BoxIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D6D6DD"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#17FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#21FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .btn: 32 px, padding 0 14, radius 8, 13 px Medium #E6E6EB, 5.5 % fill. -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" CornerRadius="8" Padding="14,0" Background="#0EFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#17FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#21FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#141416"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="34" CornerRadius="8" Padding="16,0" Background="{StaticResource ZAccentGradient}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9C9CA6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="4,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF"/><Setter Property="Foreground" Value="#F5F5F7"/></Trigger>
                            <Trigger Property="Tag" Value="current"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileProgress" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2EFFFFFF"/>
                            <Border x:Name="PART_Indicator" Background="#FF9500" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- App bar 52 px #0A0A0C, 1 px rgba(255,255,255,.06) bottom line, padding 0 20 0 14. -->
        <Border Grid.Row="0" Background="#0A0A0C" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="14,0,20,0">
            <DockPanel LastChildFill="False">
                <Button x:Name="MoviesButton" Style="{StaticResource NavPill}" Tag="sel" Click="OnMovies" ToolTip="Movies" AutomationProperties.AutomationId="NavMovies">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" ><Canvas Width="24" Height="24"><Path Data="M5.5,4.5 H18.5 A2,2 0 0 1 20.5,6.5 V17.5 A2,2 0 0 1 18.5,19.5 H5.5 A2,2 0 0 1 3.5,17.5 V6.5 A2,2 0 0 1 5.5,4.5 Z M7.5,4.5 V19.5 M16.5,4.5 V19.5 M3.5,9 H7.5 M3.5,15 H7.5 M16.5,9 H20.5 M16.5,15 H20.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBlock Text="Movies" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PhoneCard" Style="{StaticResource NavPill}" Click="OnPairing" AutomationProperties.AutomationId="NavPhone">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" ><Canvas Width="24" Height="24"><Path Data="M9.4,2.8 H14.6 A2.4,2.4 0 0 1 17,5.2 V18.8 A2.4,2.4 0 0 1 14.6,21.2 H9.4 A2.4,2.4 0 0 1 7,18.8 V5.2 A2.4,2.4 0 0 1 9.4,2.8 Z M10.5,18 H13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBlock x:Name="PhoneCardName" Text="No phone" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        <Ellipse x:Name="PhoneConnectedDot" Width="7" Height="7" Fill="#5C5C66" Margin="9,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PhoneCardStatus" Text="Not paired" Foreground="#8E8E98" FontSize="12.5" FontWeight="Normal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PairButton" Style="{StaticResource NavPill}" Click="OnPairing" AutomationProperties.AutomationId="NavPair">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" ><Canvas Width="24" Height="24"><Path Data="M7.4,2.8 H12.6 A2.4,2.4 0 0 1 15,5.2 V18.8 A2.4,2.4 0 0 1 12.6,21.2 H7.4 A2.4,2.4 0 0 1 5,18.8 V5.2 A2.4,2.4 0 0 1 7.4,2.8 Z M8.5,18 H11.5 M19,8 V14 M16,11 H22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBlock Text="Pair phones" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource NavPill}" Click="OnSettings" AutomationProperties.AutomationId="NavSettings">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" ><Canvas Width="24" Height="24"><Path Data="M 12 8.6 a 3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0 -6.8 z M 19.4 13.5 l 1.5 1.2 -2 3.4 -1.8 -.7 a 7.6 7.6 0 0 1 -2 1.2 L 14.8 21 h -3.9 l -.4 -2.4 a 7.6 7.6 0 0 1 -2 -1.2 l -1.8 .7 -2 -3.4 1.5 -1.2 a 7.7 7.7 0 0 1 0 -2.4 L 4.7 9.9 l 2 -3.4 1.8 .7 a 7.6 7.6 0 0 1 2 -1.2 L 10.9 3.6 h 3.9 l .4 2.4 a 7.6 7.6 0 0 1 2 1.2 l 1.8 -.7 2 3.4 -1.5 1.2 a 7.7 7.7 0 0 1 0 2.4 z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBlock Text="Settings" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Search 300x34, radius 8, #141418, 1 px rgba(255,255,255,.07). Filters the current folder. -->
                <Border DockPanel.Dock="Right" Width="300" Height="34" CornerRadius="8" Background="#141418" BorderBrush="#12FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                    <Grid Margin="12,0,10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M4.5,11 A6.5,6.5 0 1 0 17.5,11 A6.5,6.5 0 1 0 4.5,11 Z M16,16 L20,20" Stroke="#8E8E98" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" Background="Transparent" Foreground="#F5F5F7" CaretBrush="#F5F5F7" SelectionBrush="#FF9500"
                                 BorderThickness="0" Padding="0" FontSize="13" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Margin="8,0,0,0" Text="Search movies" Foreground="#8E8E98" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Connection notice (notice-only, owner-settled): shown only when something
             would block the phone; the healthy state has no strip (render 01). -->
        <Border x:Name="NoticeBar" Grid.Row="1" Background="#141418" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="40,8" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C9C9D1" FontSize="12.5"/>
        </Border>

        <Grid Grid.Row="2">
            <!-- Empty state: no movies folder chosen yet -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M 3.5 7.5 A 1.5 1.5 0 0 1 5 6 h 4 l 2 2 h 8 a 1.5 1.5 0 0 1 1.5 1.5 v 8 A 1.5 1.5 0 0 1 19 19 H 5 a 1.5 1.5 0 0 1 -1.5 -1.5 z" Stroke="#FF9500" StrokeThickness="1.2" StrokeLineJoin="Round"/></Canvas></Viewbox>
                <TextBlock Text="Pick your movies folder" Foreground="#F5F5F7" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="EmptyStateDetail" Text="Choose the folder you want to browse." Foreground="#8E8E98" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <Button Style="{StaticResource OrangeButton}" Content="Choose movies folder" Click="OnBrowseFolder" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Library: command row + one continuous grid, folders first. -->
            <Grid x:Name="LibraryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Command row 56 px, side padding 40 -->
                <DockPanel Grid.Row="0" Margin="40,0" LastChildFill="False">
                    <Button x:Name="BackButton" Style="{StaticResource BoxIconButton}" Click="OnBack" ToolTip="Back" AutomationProperties.AutomationId="LibraryBack"><Viewbox Width="17" Height="17" ><Canvas Width="24" Height="24"><Path Data="M 19 12 H 5 M 11 6 l -6 6 6 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <Button x:Name="UpButton" Style="{StaticResource BoxIconButton}" Click="OnUp" ToolTip="Up one folder" Margin="6,0,0,0" AutomationProperties.AutomationId="LibraryUp"><Viewbox Width="17" Height="17" ><Canvas Width="24" Height="24"><Path Data="M 12 19 V 5 M 6 11 l 6 -6 6 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource BoxIconButton}" Click="OnRefresh" ToolTip="Refresh" Margin="6,0,0,0" AutomationProperties.AutomationId="LibraryRefresh"><Viewbox Width="17" Height="17" ><Canvas Width="24" Height="24"><Path Data="M 19.5 12 a 7.5 7.5 0 1 1 -2.2 -5.3 M 19.5 4.5 v 4 h -4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <!-- Folder icon doubles as "Change movies folder" (existing capability kept). -->
                    <Button x:Name="FolderButton" Style="{StaticResource CrumbButton}" Click="OnBrowseFolder" ToolTip="Change movies folder" Margin="16,0,2,0" VerticalAlignment="Center"><Viewbox Width="16" Height="16" ><Canvas Width="24" Height="24"><Path Data="M 3.5 7.5 A 1.5 1.5 0 0 1 5 6 h 4 l 2 2 h 8 a 1.5 1.5 0 0 1 1.5 1.5 v 8 A 1.5 1.5 0 0 1 19 19 H 5 a 1.5 1.5 0 0 1 -1.5 -1.5 z" Stroke="#9C9CA6" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="CountText" Foreground="#8E8E98" FontSize="12.5" Margin="14,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Click="OnSort" VerticalAlignment="Center" AutomationProperties.AutomationId="LibrarySort">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M 7 5 v 14 M 4 16 l 3 3 3 -3 M 13 7 h 7 M 13 12 h 5 M 13 17 h 3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                            <TextBlock x:Name="SortLabel" Text="Name · Folders first" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M 6 9 l 6 6 6 -6" Stroke="#8E8E98" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- One continuous grid, one ScrollViewer (the ListBox's own). -->
                <ListBox x:Name="MovieList" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,4,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False" SizeChanged="OnGridSizeChanged"
                         MouseDoubleClick="OnEntryOpen" KeyDown="OnEntryKey" FocusVisualStyle="{x:Null}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="Scroller" Focusable="False" Padding="40,10,42,24" CanContentScroll="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Margin="0,0,-24,0"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- -6 / +4 / 2 nets to zero: the ring sits around the tile without moving it.
                                 Right/bottom margin carries the 24 x 22 grid gaps. -->
                            <Setter Property="Margin" Value="-6,-6,18,16"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#0AFFFFFF"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#FF9500"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="{Binding TileWidth, ElementName=Root}">
                                <!-- Folder: orange outline folder (2 px #FF9500, 4.5 % fill) with the cover inside. -->
                                <Viewbox Stretch="Uniform" Visibility="{Binding FolderVis}" HorizontalAlignment="Left" Width="{Binding TileWidth, ElementName=Root}">
                                    <Canvas Width="169" Height="127">
                                        <Path x:Name="FolderShape" Data="M 3 18 V 8 a 5 5 0 0 1 5 -5 H 58.2 a 5 5 0 0 1 4 2 l 5 6.5 H 161 a 5 5 0 0 1 5 5 V 119 a 5 5 0 0 1 -5 5 H 8 a 5 5 0 0 1 -5 -5 Z" Fill="#0BFF9500" Stroke="#FF9500" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        <Grid Canvas.Left="10" Canvas.Top="21" Width="149" Height="96" Visibility="{Binding PeekVis}">
                                            <Grid.Clip><RectangleGeometry Rect="0,0,149,96" RadiusX="5" RadiusY="5"/></Grid.Clip>
                                            <Image Source="{Binding Peek}" Stretch="UniformToFill"/>
                                        </Grid>
                                        <Rectangle Canvas.Left="10" Canvas.Top="21" Width="149" Height="96" RadiusX="5" RadiusY="5" Stroke="#1AFFFFFF" StrokeThickness="1" Visibility="{Binding PeekVis}"/>
                                        <Grid Canvas.Left="136" Canvas.Top="94" Width="22" Height="22" Visibility="{Binding WatchedVis}">
                                            <Ellipse Fill="#F5F5F7"/>
                                            <Path Data="M 6 11 l 3.5 3.5 6.5 -7" Stroke="#141416" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                                <!-- Video: 16:10 thumbnail, radius 8, inner outline, duration badge, resume bar. -->
                                <Grid x:Name="Thumb" Visibility="{Binding FileVis}" Width="{Binding TileWidth, ElementName=Root}" Height="{Binding ThumbHeight, ElementName=Root}" HorizontalAlignment="Left">
                                    <Grid.Clip>
                                        <MultiBinding Converter="{StaticResource RoundedClip}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Grid.Clip>
                                    <Border Background="#141418"/>
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                    <Border Background="#B8000000" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,7" Visibility="{Binding DurationVis}">
                                        <TextBlock Text="{Binding Duration}" Foreground="#F5F5F7" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                    <ProgressBar Style="{StaticResource TileProgress}" Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressVis}"/>
                                    <Border x:Name="Outline" CornerRadius="8" BorderBrush="#0FFFFFFF" BorderThickness="1"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Name}" Foreground="#EDEDF1" FontSize="13" FontWeight="Medium" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Detail}" Foreground="#8E8E98" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="FolderShape" Property="Stroke" Value="#FFB54D"/>
                                    <Setter TargetName="Outline" Property="BorderBrush" Value="#33FFFFFF"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyFolderText" Grid.Row="1" Text="This folder is empty." Foreground="#8E8E98"
                           FontSize="13" Margin="40,10,40,0" Visibility="Collapsed" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
