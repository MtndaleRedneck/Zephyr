<UserControl x:Class="ZephyrPlayer.FeedbackPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F7">
    <!-- Settings > Feedback & bugs (CP3 item 82): the 1.4 feedback flow in the 2.0 theme.
         What is sent and how is unchanged. -->
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,14,0,0">
        <TextBlock Text="What happened?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="MessageTextBox" Style="{StaticResource ZTextField}" Height="150" Padding="10,8" VerticalContentAlignment="Stretch"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged"
                 ToolTip="Don't include passwords, pairing codes, or other secrets." AutomationProperties.AutomationId="FeedbackMessage" AutomationProperties.Name="What happened?"/>
        <Border Style="{StaticResource ZCard}" Margin="0,12,0,0" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Exactly what gets sent:" Foreground="#FF9500" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="Reports may become public - don't include passwords, pairing codes, or other secrets." Foreground="#8E8E98" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="PreviewText" Foreground="#B4B4BE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="FormNote" Text="The feedback form is being linked - use the GitHub issue for now."
                       Foreground="#8E8E98" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"/>
            <Button x:Name="FormButton" Style="{StaticResource ZTextButton}" Tag="or" Content="Open feedback form" Click="OnForm" Margin="0,0,8,0" AutomationProperties.AutomationId="FeedbackFormButton"/>
            <Button x:Name="IssueButton" Style="{StaticResource ZTextButton}" Content="Open GitHub issue" Click="OnIssue" AutomationProperties.AutomationId="FeedbackIssueButton"/>
        </WrapPanel>
    </StackPanel>
</UserControl>
