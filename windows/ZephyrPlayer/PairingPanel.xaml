<UserControl x:Class="ZephyrPlayer.PairingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
      <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="#1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20,16">

        <!-- Pair new phone -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Pair new phone" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="PhoneNameBox" VerticalContentAlignment="Center"
                                 Background="#1B1B1E" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 Padding="10,7" FontSize="13" MaxLength="40"
                                 TextChanged="OnPhoneNameChanged"/>

                        <TextBlock x:Name="PhoneNameHint" Text="Type a name to pair" IsHitTestVisible="False"
                                   Foreground="#6E6E76" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <Button x:Name="PairButton" Background="#D07600" Grid.Column="1" Style="{StaticResource OrangeButton}" Content="Pair" Click="OnPair" Margin="12,0,0,0"/>
                </Grid>
                <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Enter this code in the Zephyr app on your phone. Works once, for 10 minutes." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Pairing code:" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PairCodeText" Text="" Foreground="{StaticResource OrangeBrush}"
                               FontSize="34" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="ExpiresText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <Button Style="{StaticResource LinkButton}" Content="Cancel" FontSize="12" Click="OnCancelCode"/>
                    </StackPanel>
                    <TextBlock x:Name="ThisPcText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Paired phones -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Paired phones" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoPhonesText" Text="No phones paired yet." Foreground="{StaticResource MutedBrush}" FontSize="12" Visibility="Collapsed"/>
                <ItemsControl x:Name="PhoneList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding Paired}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Forget" FontSize="12"
                                        Tag="{Binding Token}" Click="OnRemovePhone"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border x:Name="WarningPanel" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,10">
            <DockPanel LastChildFill="True">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>