<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="WindowBrush" Color="#1B1B1E"/><SolidColorBrush x:Key="LayerBrush" Color="#232328"/>
 <SolidColorBrush x:Key="CardBrush" Color="#26262D"/><SolidColorBrush x:Key="Card2Brush" Color="#2E2E36"/>
 <SolidColorBrush x:Key="NavSelectedBrush" Color="#2E2E36"/><SolidColorBrush x:Key="OrangeBrush" Color="#FF9500"/>
 <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/><SolidColorBrush x:Key="MutedBrush" Color="#9696A0"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
 <Style TargetType="ContextMenu"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
 <Style TargetType="MenuItem"><Setter Property="Padding" Value="14,9"/></Style>
</ResourceDictionary>