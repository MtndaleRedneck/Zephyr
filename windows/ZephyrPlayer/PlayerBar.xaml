<UserControl x:Class="ZephyrPlayer.PlayerBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Focusable="False" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F7">
    <!-- The player's control bar (render 02), its own control since CP3 (item 73): the
         player view hosts it over the video, and Settings > Skip buttons / Playback bar
         hosts a second instance in preview mode as the LIVE PREVIEW, styled by the same
         ApplyStyle. Handlers are wired by the player view (PlayerView.BindBar). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Border x:Name="ControlBar" x:FieldModifier="internal"
                VerticalAlignment="Bottom" Margin="20" Padding="18,10,18,9" CornerRadius="16"
                Background="#BD0C0C0F" BorderBrush="#16FFFFFF" BorderThickness="1" Opacity="0"
               >
            <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="18" Direction="270" Opacity="0.55" Color="Black"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Seek row 16 px, gap 14: elapsed (62) | track | remaining (62). -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" x:FieldModifier="internal" Text="0:00" Foreground="#E9E9EE" FontSize="12" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    <Slider x:Name="SeekBar" x:FieldModifier="internal" Grid.Column="1" Margin="14,0" Style="{StaticResource ZSeekSlider}" Minimum="0" Maximum="1000" Value="0" Foreground="#FF9500" VerticalAlignment="Center"
                           />
                    <TextBlock x:Name="RemainingText" x:FieldModifier="internal" Grid.Column="2" Text="-0:00" Foreground="#B4B4BE" FontSize="12" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <!-- Controls row, 3 columns (*, Auto, *): Play on the centre line, equal sides. -->
                <Grid x:Name="ControlsRow" x:FieldModifier="internal" Grid.Row="1" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- "1:42:08 total" under the remaining time (0.85 em, 60 %), drawn over the
                         top of the controls row as in the render. -->
                    <TextBlock x:Name="TotalText" x:FieldModifier="internal" Grid.Column="2" Text="0:00 total" Foreground="#B4B4BE" Opacity="0.6" FontSize="10.2" FontWeight="Medium" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0" IsHitTestVisible="False"/>
                    <!-- Volume group, gap 10: speaker 38 px, track 92x4, % label. -->
                    <StackPanel x:Name="VolumeGroup" x:FieldModifier="internal" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="VolumeButton" x:FieldModifier="internal" Style="{StaticResource ZBarButton}" Width="38" ToolTip="Mute (M)">
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                                <Path x:Name="VolumeBody" x:FieldModifier="internal" Data="M4,9.5 H7 L11,6 V18 L7,14.5 H4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                <Path x:Name="VolumeGlyph" x:FieldModifier="internal" Data="M15,9.2 A4,4 0 0 1 15,14.8 M17.6,6.8 A7.5,7.5 0 0 1 17.6,17.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas></Viewbox>
                        </Button>
                        <Slider x:Name="VolumeSlider" x:FieldModifier="internal" Style="{StaticResource ZVolumeSlider}" Width="92" Minimum="0" Maximum="100" Value="100" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolumeLabel" x:FieldModifier="internal" Text="100%" MinWidth="36" Foreground="#E9E9EE" FontSize="12.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- Centre cluster, gap 14: 30s back, 10s back, Play/Pause, 10s fwd, 30s fwd. -->
                    <StackPanel x:Name="CenterPlaybackControls" x:FieldModifier="internal" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="SecondarySkipBackButton" x:FieldModifier="internal" Style="{StaticResource ZGlyphButton}" ToolTip="Skip back" AutomationProperties.Name="Secondary skip backward" Width="44" Height="44">
                            <Grid x:Name="SecondaryBackBox" x:FieldModifier="internal" Width="40" Height="40" ClipToBounds="False">
                                <Viewbox><Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5" ClipToBounds="False"><Canvas.RenderTransform><RotateTransform x:Name="SecondaryBackSpin" x:FieldModifier="internal"/></Canvas.RenderTransform>
                                    <Path x:Name="SecondarySkipBackIcon" x:FieldModifier="internal" Data="M20.27,10.39 A8.8,8.8 0 0 0 3.73,10.39" Stroke="#FF9500" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="SecondarySkipBackHead" x:FieldModifier="internal" Data="M2.92,12.62 L1.95,9.08 L5.94,10.53 Z" Fill="#FF9500" Stroke="#FF9500" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                                </Canvas></Viewbox>
                                <TextBlock x:Name="SecondarySkipBackLabel" x:FieldModifier="internal" Text="30s" Foreground="#FF9500" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SkipBackButton" x:FieldModifier="internal" Style="{StaticResource ZGlyphButton}" ToolTip="Primary skip backward" AutomationProperties.Name="Primary skip backward" Width="46" Height="46" Margin="14,0,0,0">
                            <Grid x:Name="SkipBackBox" x:FieldModifier="internal" Width="42" Height="42">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><RotateTransform x:Name="SkipBackSpin" x:FieldModifier="internal" Angle="0"/></Grid.RenderTransform>
                                    <Viewbox><Canvas Width="24" Height="24">
                                        <Path x:Name="SkipBackRing" x:FieldModifier="internal" Data="M17.79,18.89 A9,9 0 1 0 6.21,18.89" Stroke="#F5F5F7" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path x:Name="SkipBackArrow" x:FieldModifier="internal" Data="M7.89,20.30 L4.52,20.02 L7.03,17.03 Z" Fill="#F5F5F7" Stroke="#F5F5F7" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                                    </Canvas></Viewbox>
                                </Grid>
                                <TextBlock x:Name="SkipBackLabel" x:FieldModifier="internal" Text="10s" Foreground="#F5F5F7" FontSize="12.6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="PlayPauseButton" x:FieldModifier="internal" Style="{StaticResource ZGlyphButton}" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play or pause" Width="50" Height="50" Margin="22,0,22,0">
                            <Grid x:Name="PlayBox" x:FieldModifier="internal" Width="50" Height="50">
                                <Viewbox><Canvas Width="24" Height="24">
                                    <Ellipse x:Name="PlayRing" x:FieldModifier="internal" Canvas.Left="1.6" Canvas.Top="1.6" Width="20.8" Height="20.8" Stroke="#FF9500" StrokeThickness="1.25" Fill="#1AFF9500"/>
                                    <Path x:Name="PlayGlyph" x:FieldModifier="internal" Data="M9.4,7.9 L16.2,12 L9.4,16.1 Z" Fill="#FF9500" Stroke="#FF9500" StrokeThickness="0.9" StrokeLineJoin="Round"/>
                                </Canvas></Viewbox>
                                <!-- Pause bars: 2.3 x 7.6 of 24 at x 9 and 12.7 (render 02), i.e. 4.8 x 15.8 px. -->
                                <Grid x:Name="PauseGlyph" x:FieldModifier="internal" Width="12.5" Height="15.8" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="4.8" Height="15.8" RadiusX="1.7" RadiusY="1.7" Fill="#FF9500" HorizontalAlignment="Left"/>
                                    <Rectangle Width="4.8" Height="15.8" RadiusX="1.7" RadiusY="1.7" Fill="#FF9500" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="SkipForwardButton" x:FieldModifier="internal" Style="{StaticResource ZGlyphButton}" ToolTip="Primary skip forward" AutomationProperties.Name="Primary skip forward" Width="46" Height="46" Margin="0,0,14,0">
                            <Grid x:Name="SkipForwardBox" x:FieldModifier="internal" Width="42" Height="42">
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><RotateTransform x:Name="SkipForwardSpin" x:FieldModifier="internal" Angle="0"/></Grid.RenderTransform>
                                    <Viewbox><Canvas Width="24" Height="24">
                                        <Path x:Name="SkipForwardRing" x:FieldModifier="internal" Data="M6.21,18.89 A9,9 0 1 1 17.79,18.89" Stroke="#F5F5F7" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path x:Name="SkipForwardArrow" x:FieldModifier="internal" Data="M16.11,20.30 L16.97,17.03 L19.48,20.02 Z" Fill="#F5F5F7" Stroke="#F5F5F7" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                                    </Canvas></Viewbox>
                                </Grid>
                                <TextBlock x:Name="SkipForwardLabel" x:FieldModifier="internal" Text="10s" Foreground="#F5F5F7" FontSize="12.6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SecondarySkipForwardButton" x:FieldModifier="internal" Style="{StaticResource ZGlyphButton}" ToolTip="Skip forward" AutomationProperties.Name="Secondary skip forward" Width="44" Height="44">
                            <Grid x:Name="SecondaryForwardBox" x:FieldModifier="internal" Width="40" Height="40" ClipToBounds="False">
                                <Viewbox><Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5" ClipToBounds="False"><Canvas.RenderTransform><RotateTransform x:Name="SecondaryForwardSpin" x:FieldModifier="internal"/></Canvas.RenderTransform>
                                    <Path x:Name="SecondarySkipForwardIcon" x:FieldModifier="internal" Data="M3.73,10.39 A8.8,8.8 0 0 1 20.27,10.39" Stroke="#FF9500" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="SecondarySkipForwardHead" x:FieldModifier="internal" Data="M21.08,12.62 L18.06,10.53 L22.05,9.08 Z" Fill="#FF9500" Stroke="#FF9500" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                                </Canvas></Viewbox>
                                <TextBlock x:Name="SecondarySkipForwardLabel" x:FieldModifier="internal" Text="30s" Foreground="#FF9500" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <!-- Right group, gap 4: subtitles, speed, sleep, fullscreen (38 px, radius 9,
                         icons 21-22 px at stroke 1.6, active #FF9500, badges 12 px SemiBold). -->
                    <StackPanel x:Name="RightGroup" x:FieldModifier="internal" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CaptionsButton" x:FieldModifier="internal" Style="{StaticResource ZBarButton}" ToolTip="Subtitles" AutomationProperties.Name="Subtitles">
                            <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M6,5 H18 A3,3 0 0 1 21,8 V15 A3,3 0 0 1 18,18 H6 A3,3 0 0 1 3,15 V8 A3,3 0 0 1 6,5 Z"/>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8,18 L6.5,21 L11,18 M7,10.5 H12 M14.5,10.5 H17 M7,14 H9.5 M12,14 H17"/>
                            </Canvas></Viewbox>
                        </Button>
                        <Button x:Name="SpeedButton" x:FieldModifier="internal" Style="{StaticResource ZBarButton}" Margin="4,0,0,0" ToolTip="Playback speed" AutomationProperties.Name="Playback speed">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.2,17.5 A9,9 0 1 1 19.8,17.5 M12,13.2 L16,9 M12,5.5 V6.9 M6.4,8 L7.4,9 M17.6,8 L16.6,9 M4.6,13 H6 M18,13 H19.4"/>
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M10.6,13.6 A1.4,1.4 0 1 1 13.4,13.6 A1.4,1.4 0 1 1 10.6,13.6 Z"/>
                                </Canvas></Viewbox>
                                <TextBlock x:Name="SpeedLabel" x:FieldModifier="internal" Visibility="Collapsed" Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#FF9500" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SleepButton" x:FieldModifier="internal" Style="{StaticResource ZBarButton}" Margin="4,0,0,0" ToolTip="Sleep timer" AutomationProperties.Name="Sleep timer">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M19.5,14.6 A8,8 0 0 1 9.4,4.5 A8,8 0 1 0 19.5,14.6 Z"/>
                                </Canvas></Viewbox>
                                <TextBlock x:Name="SleepLabel" x:FieldModifier="internal" Visibility="Collapsed" Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#FF9500" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullscreenButton" x:FieldModifier="internal" Style="{StaticResource ZBarButton}" Margin="4,0,0,0" ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
                            <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24">
                                <Path x:Name="FullscreenGlyph" x:FieldModifier="internal" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,9 V5.5 A1.5,1.5 0 0 1 5.5,4 H9 M15,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V9 M20,15 V18.5 A1.5,1.5 0 0 1 18.5,20 H15 M9,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V15"/>
                            </Canvas></Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
</UserControl>
