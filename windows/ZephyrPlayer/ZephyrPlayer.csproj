<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stack: WPF + LibVLCSharp.
       Cross-builds in CI on Linux with EnableWindowsTargeting. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <AssemblyName>ZephyrPlayer</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unit tests probe internal updater/input helpers without widening the
         app's public surface. -->
    <InternalsVisibleTo Include="ZephyrPlayer.Tests" />
    <Resource Include="assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.*" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />
      <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <!-- CI-only evidence hooks stay out of the shipped binary: passing -p:CaptureHook=true
       APPENDS the constant instead of clobbering the project's DefineConstants (round-6 S6-7). -->
  <PropertyGroup Condition="'$(CaptureHook)' == 'true'">
    <DefineConstants>$(DefineConstants);CI_CAPTURE_HOOK;PAIR_CODE_HOOK;WINDOW_SHOT_HOOK</DefineConstants>
  </PropertyGroup>
</Project>
