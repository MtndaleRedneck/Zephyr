<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stack: WPF + LibVLCSharp.
       Cross-builds in CI on Linux with EnableWindowsTargeting. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <AssemblyName>ZephyrPlayer</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unit tests probe internal updater/input helpers without widening the
         app's public surface. -->
    <InternalsVisibleTo Include="ZephyrPlayer.Tests" />
    <Resource Include="assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.33" PrivateAssets="all" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
      <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <!-- CI-only evidence hooks stay out of the shipped binary: passing -p:CaptureHook=true
       APPENDS the constant instead of clobbering the project's DefineConstants (round-6 S6-7). -->
  <PropertyGroup Condition="'$(CaptureHook)' == 'true'">
    <DefineConstants>$(DefineConstants);CI_CAPTURE_HOOK;PAIR_CODE_HOOK;WINDOW_SHOT_HOOK</DefineConstants>
  </PropertyGroup>
</Project>
