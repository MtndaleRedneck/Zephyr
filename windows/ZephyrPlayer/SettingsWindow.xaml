<Window x:Class="ZephyrPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Settings" Width="900" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0E0E11" Icon="/ZephyrPlayer;component/assets/icon.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F7"
        WindowStartupLocation="CenterOwner">
    <!-- CP3 (renders 05, 06, 06b): a SEPARATE compact window, 900x600, centred on the shell
         (which dims behind it), #0E0E11 with a 1 px rgba(255,255,255,.10) border, a 32 px
         caption "Zephyr Settings" with a close button only. Left nav 216 px; content panel
         #121215 with a 10 px top-left radius. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsClose" TargetType="Button">
                <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
                <Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="#C9C9D1"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#B22A1B"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#1AFFFFFF" BorderThickness="1" Background="#0E0E11">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <!-- Caption: icon + "Zephyr Settings", close only. -->
            <Grid Background="#0E0E11">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="CaptionIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Zephyr Settings" Margin="10,0,0,0" FontSize="12" FontWeight="Medium" Foreground="#C9C9D1" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseButton" Style="{StaticResource SettingsClose}" HorizontalAlignment="Right" Click="OnClose" ToolTip="Close" AutomationProperties.AutomationId="SettingsClose" AutomationProperties.Name="Close"><Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- Left nav (render 06): four at the top, Feedback & bugs and Updates pinned to the
                     bottom with the version line under them. -->
                <DockPanel Margin="10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="NavVolume" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="volume" AutomationProperties.AutomationId="NavVolume" AutomationProperties.Name="Volume"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,9.5 h3 l4,-3.5 v12 l-4,-3.5 H4 z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M15,9.2 a4,4 0 0 1 0,5.6 M17.6,6.8 a7.5,7.5 0 0 1 0,10.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Volume" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavSkip" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="skip" AutomationProperties.AutomationId="NavSkip" AutomationProperties.Name="Skip buttons"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5.5,15.5 A7,7 0 1 1 12,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M5.5,11 v4.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Skip buttons" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavBar" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="bar" AutomationProperties.AutomationId="NavBar" AutomationProperties.Name="Playback bar"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="3" Canvas.Top="13" Width="18" Height="7" RadiusX="2.5" RadiusY="2.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Ellipse Canvas.Left="10.6" Canvas.Top="15.1" Width="2.8" Height="2.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Data="M3,8 h18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="7.4" Canvas.Top="6.4" Width="3.2" Height="3.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox><TextBlock Text="Playback bar" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavRemote" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="remote" AutomationProperties.AutomationId="NavRemote" AutomationProperties.Name="Paired phones"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="7" Canvas.Top="2.8" Width="10" Height="18.4" RadiusX="2.4" RadiusY="2.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Path Data="M10.5,18 h3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Paired phones" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="NavFeedback" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="feedback" AutomationProperties.AutomationId="NavFeedback" AutomationProperties.Name="Feedback &amp; bugs"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="7" Canvas.Top="7" Width="10" Height="13" RadiusX="5" RadiusY="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Path Data="M9,7.5 a3,3 0 0 1 6,0 M12,11 v9 M4,13 h3 M17,13 h3 M5,8.5 l2.5,1.5 M19,8.5 L16.5,10 M5,18.5 l2.5,-1.5 M19,18.5 L16.5,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Feedback &amp; bugs" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavUpdates" Tag="" Style="{StaticResource ZNavItem}" Click="OnNav" CommandParameter="updates" AutomationProperties.AutomationId="NavUpdates" AutomationProperties.Name="Updates"><StackPanel Orientation="Horizontal"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M12,4 v11 M7.5,10.5 L12,15 l4.5,-4.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M5,19.5 h14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox><TextBlock Text="Updates" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock x:Name="NavVersionText" Foreground="#8E8E98" FontSize="11.5" Margin="12,8,12,4" AutomationProperties.AutomationId="NavVersionText"/>
                    </StackPanel>
                </DockPanel>
                <!-- Content panel (render 06 .content): #121215, top-left radius 10, top and left
                     1 px rgba(255,255,255,.06), padding 22 28, title 22 SemiBold, one muted line. -->
                <Border Grid.Column="1" Background="#121215" CornerRadius="10,0,0,0" BorderBrush="#0FFFFFFF" BorderThickness="1,1,0,0">
                    <Grid Margin="28,22,10,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Foreground="#F5F5F7" Margin="0,0,18,0" AutomationProperties.AutomationId="SectionTitle"/>
                        <TextBlock x:Name="SectionDescription" Grid.Row="1" FontSize="13" Foreground="#8E8E98" Margin="0,4,18,0" TextWrapping="Wrap"/>
                        <ScrollViewer x:Name="SectionScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,18,22">
                            <Grid>
                    <!-- Volume (U1: not rendered; checklist minimum + Boost kept, owner decision 2 / O17) -->
                    <StackPanel x:Name="SectionVolume" Visibility="Collapsed">
                        <Border Style="{StaticResource ZCard}" x:Name="BoostCard"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,9.5 h3 l4,-3.5 v12 l-4,-3.5 H4 z" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="#D9D9E0"/><Path Data="M15,9.2 a4,4 0 0 1 0,5.6 M17.6,6.8 a7.5,7.5 0 0 1 0,10.4 M20.2,4.4 a11,11 0 0 1 0,15.2" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Boost up to"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Extra loudness above 100%. The bar slider still reads 0 to 100."/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><WrapPanel x:Name="BoostPanel" HorizontalAlignment="Right"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}" x:Name="RememberCard"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,9.5 h3 l4,-3.5 v12 l-4,-3.5 H4 z" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="#D9D9E0"/><Path Data="M15,9.2 a4,4 0 0 1 0,5.6 M17.6,6.8 a7.5,7.5 0 0 1 0,10.4" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Remembers your last volume"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Zephyr opens at the volume you last used. Windows volume is not changed."/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"></Grid></Grid></Border>
                    </StackPanel>

                    <!-- Skip buttons (render 06) -->
                    <StackPanel x:Name="SectionSkip" Visibility="Collapsed">
                        <Border x:Name="SkipPreview" Height="118" CornerRadius="10" Margin="0,14,0,0" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2F3A" Offset="0"/><GradientStop Color="#1B1D24" Offset="0.55"/><GradientStop Color="#2B2522" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Border Background="#59000000"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" Background="#80000000" CornerRadius="5" Padding="8,3"><TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E6"/></Border><Viewbox x:Name="SkipPreviewBox" VerticalAlignment="Bottom" Margin="14,0,14,12" Stretch="Uniform" StretchDirection="DownOnly"/></Grid></Border>
                        <Border Style="{StaticResource ZCard}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M6.21,18.89 A9,9 0 1 1 17.79,18.89" Stroke="#D9D9E0" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M16.11,20.30 L16.97,17.03 L19.48,20.02 Z" Fill="#D9D9E0" Stroke="#D9D9E0" StrokeThickness="0.8" StrokeLineJoin="Round"/><TextBlock Canvas.Left="6.4" Canvas.Top="6.6" Width="11.2" TextAlignment="Center" FontSize="7.2" FontWeight="Bold" Foreground="#D9D9E0" Text="10"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Primary skip buttons"/><TextBlock Style="{StaticResource ZCardDesc}" Text="The pair right beside Play"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><WrapPanel x:Name="PrimarySkipPanel" HorizontalAlignment="Right"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M3.73,10.39 A8.8,8.8 0 0 1 20.27,10.39" Stroke="#D9D9E0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M21.08,12.62 L18.06,10.53 L22.05,9.08 Z" Fill="#D9D9E0" Stroke="#D9D9E0" StrokeThickness="0.8" StrokeLineJoin="Round"/><TextBlock Canvas.Left="6.4" Canvas.Top="9.6" Width="11.2" TextAlignment="Center" FontSize="7.8" FontWeight="Bold" Foreground="#D9D9E0" Text="30"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Secondary skip buttons"/><TextBlock Style="{StaticResource ZCardDesc}" Text="The outer pair"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><WrapPanel x:Name="SecondarySkipPanel" HorizontalAlignment="Right"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M19.5,12 a7.5,7.5 0 1 1 -2.2,-5.3" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M19.5,4.5 v4 h-4" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Animate on press"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Primary arrows turn; secondary arrows get a light that runs to the tip"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="AnimateToggle" Style="{StaticResource ZToggle}" HorizontalAlignment="Right" Click="OnToggle" AutomationProperties.AutomationId="AnimateToggle" AutomationProperties.Name="Animate on press"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="17.0" Height="17.0" Stroke="#D9D9E0" StrokeThickness="1.6"/><Path Data="M12,11 v5.5 M12,7.8 v0.1" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Flash on press"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Brief colour flash when a skip is clicked"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="FlashToggle" Style="{StaticResource ZToggle}" HorizontalAlignment="Right" Click="OnToggle" AutomationProperties.AutomationId="FlashToggle" AutomationProperties.Name="Flash on press"/></Grid></Grid></Border>
                    </StackPanel>

                    <!-- Playback bar (render 06b) -->
                    <StackPanel x:Name="SectionBar" Visibility="Collapsed">
                        <Border x:Name="BarPreview" Height="118" CornerRadius="10" Margin="0,14,0,0" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2F3A" Offset="0"/><GradientStop Color="#1B1D24" Offset="0.55"/><GradientStop Color="#2B2522" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Border Background="#59000000"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" Background="#80000000" CornerRadius="5" Padding="8,3"><TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E6"/></Border><Viewbox x:Name="BarPreviewBox" VerticalAlignment="Bottom" Margin="14,0,14,12" Stretch="Uniform" StretchDirection="DownOnly"/></Grid></Border>
                        <Border Style="{StaticResource ZCard}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="3" Canvas.Top="13" Width="18" Height="7" RadiusX="2.5" RadiusY="2.5" Stroke="#D9D9E0" StrokeThickness="1.6"/><Ellipse Canvas.Left="10.6" Canvas.Top="15.1" Width="2.8" Height="2.8" Fill="#D9D9E0"/><Path Data="M3,8 h18" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="7.4" Canvas.Top="6.4" Width="3.2" Height="3.2" Fill="#D9D9E0"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Button style"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Outline or solid buttons"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><WrapPanel x:Name="IconStylePanel" HorizontalAlignment="Right"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Top"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="1.6" Canvas.Top="1.6" Width="20.8" Height="20.8" Fill="#1AFF9500" Stroke="#FF9500" StrokeThickness="1.25"/><Rectangle Canvas.Left="9" Canvas.Top="8.2" Width="2.3" Height="7.6" RadiusX="0.8" RadiusY="0.8" Fill="#FF9500"/><Rectangle Canvas.Left="12.7" Canvas.Top="8.2" Width="2.3" Height="7.6" RadiusX="0.8" RadiusY="0.8" Fill="#FF9500"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top"><TextBlock Style="{StaticResource ZCardTitle}" Text="Colours"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Default is the original"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Top"><WrapPanel x:Name="BarColorPanel" HorizontalAlignment="Right" MaxWidth="440"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4.2,17.5 a9,9 0 1 1 15.6,0" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Path Data="M12,13.2 l4,-4.2" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><Ellipse Canvas.Left="10.6" Canvas.Top="12.2" Width="2.8" Height="2.8" Fill="#D9D9E0"/><Path Data="M12,5.5 v1.4 M6.4,8 l1,1 M17.6,8 l-1,1 M4.6,13 h1.4 M18,13 h1.4" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Speed button"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Show it on the bar"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="SpeedToggle" Style="{StaticResource ZToggle}" HorizontalAlignment="Right" Click="OnToggle" AutomationProperties.AutomationId="SpeedToggle" AutomationProperties.Name="Speed button"/></Grid></Grid></Border>
                        <Border Style="{StaticResource ZCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl Focusable="False" VerticalAlignment="Center"><Border Style="{StaticResource ZCardIcon}"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M19.5,14.6 A8,8 0 0 1 9.4,4.5 a8,8 0 1 0 10.1,10.1 z" Stroke="#D9D9E0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Border></ContentControl><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource ZCardTitle}" Text="Sleep timer button"/><TextBlock Style="{StaticResource ZCardDesc}" Text="Show it on the bar"/></StackPanel><Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="SleepToggle" Style="{StaticResource ZToggle}" HorizontalAlignment="Right" Click="OnToggle" AutomationProperties.AutomationId="SleepToggle" AutomationProperties.Name="Sleep timer button"/></Grid></Grid></Border>
                    </StackPanel>

                    <!-- Paired phones (render 05): the one live pairing panel -->
                    <ContentControl x:Name="SectionRemote" Focusable="False" Visibility="Collapsed"/>

                    <!-- Feedback & bugs: the existing feedback panel, restyled -->
                    <ContentControl x:Name="SectionFeedback" Focusable="False" Visibility="Collapsed"/>

                    <!-- Updates: version, status, Check now, Download and install update -->
                    <StackPanel x:Name="SectionUpdates" Visibility="Collapsed">
                        <Border Style="{StaticResource ZCard}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
