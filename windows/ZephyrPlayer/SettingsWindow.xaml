<Window x:Class="ZephyrPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Settings" Width="560" Height="720"
        Background="#1B1B1E" Icon="/ZephyrPlayer;component/assets/icon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#26262D"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F97C02"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9696A0"/>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,14,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Ring" Width="15" Height="15" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Fill="#26262D"/>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource OrangeBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource OrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3,14,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="3" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.5" Background="#26262D"/>
                                <Path x:Name="Tick" Data="M3.5,8 L6.5,11 L11.5,4.5" Stroke="{StaticResource OrangeBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="#1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Movies folder" Style="{StaticResource Heading}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderText" Grid.Column="0" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Style="{StaticResource OrangeButton}" Content="Browse..." Click="OnBrowse" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Text="Your designated folder. Home shows these movies when nothing is playing, and your phone browses the same folder."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Volume" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Small}" Text="The bar slider always reads 0-100 and matches Windows volume. Boost is extra loudness the player adds on top."/>
                    <TextBlock Text="Boost up to:" Foreground="{StaticResource TextBrush}" Margin="0,8,0,2"/>
                    <WrapPanel x:Name="BoostPanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Skip buttons" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Back:" Foreground="{StaticResource TextBrush}"/>
                    <WrapPanel x:Name="SkipBackPanel"/>
                    <TextBlock Text="Forward:" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                    <WrapPanel x:Name="SkipForwardPanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Playback bar" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Colors:" Foreground="{StaticResource TextBrush}"/>
                    <WrapPanel x:Name="BarColorPanel"/>
                    <TextBlock Text="Icons:" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                    <WrapPanel x:Name="IconStylePanel"/>
                    <CheckBox x:Name="SpeedToggle" Content="Show playback-speed button (off by default)" Margin="0,10,0,0" Click="OnToggle"/>
                    <CheckBox x:Name="SleepToggle" Content="Show sleep-timer button (off by default)" Click="OnToggle"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Text="Changes apply to the player right away, so you can see them live."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Android remote" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="PairStatusText" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <Button x:Name="PairButton" Style="{StaticResource OrangeButton}" Content="Show pairing code" Click="OnPair" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PairCodeText" Style="{StaticResource Small}" Foreground="#F0C23E" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Feedback" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Small}" Text="Something off or missing?"/>
                    <Button Style="{StaticResource OrangeButton}" Content="Send feedback" Click="OnFeedback" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>


            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Small}" Margin="0,4,0,0"/>
                    <Button Style="{StaticResource OrangeButton}" Content="Check now" Click="OnCheckUpdates" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Text="Zephyr also checks automatically every time it opens."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
