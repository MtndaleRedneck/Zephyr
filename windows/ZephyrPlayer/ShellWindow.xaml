<Window x:Class="ZephyrPlayer.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player" Icon="/ZephyrPlayer;component/assets/icon.ico"
        Width="1600" Height="1000" MinWidth="760" MinHeight="480"
        Background="#060607" ResizeMode="CanResize" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- The ONE top-level window of the app (2.0, P0-1/P0-2). Library and player are
         views swapped in place inside ViewHost; nothing hides one window to show another. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="#C9C9D1"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid><Border x:Name="Bg" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="Hl" Background="#FFFFFF" Opacity="0" CornerRadius="0" IsHitTestVisible="False"/><Border x:Name="Pr" Background="#FFFFFF" Opacity="0" CornerRadius="0" IsHitTestVisible="False"/></Grid>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0.0706" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="Opacity" To="0.0548" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#B22A1B"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CaptionRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Caption bar 32 px #0A0A0C: icon + "Zephyr Player" 12 px Medium #C9C9D1 (render 01).
             2.0.1 (Ezzy: "Weird icon"): the window buttons are Windows' own caption glyphs
             (Segoe Fluent Icons, Segoe MDL2 Assets on Windows 10), hinted at every scale;
             the hand-drawn 10 px restore glyph merged into one box at 100 %. -->
        <Border x:Name="CaptionBar" Background="#0A0A0C">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="CaptionIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Zephyr Player" Margin="10,0,0,0" FontSize="12" FontWeight="Medium" Foreground="#C9C9D1" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.AutomationId="CaptionMinimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.AutomationId="CaptionMaximize">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="OnCloseButton" ToolTip="Close" AutomationProperties.AutomationId="CaptionClose">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Views stack here. Normally one child; during a library<->player switch the
             outgoing library stays drawn under the incoming view until the switch has
             something to show (see ShellWindow.ShowView). -->
        <Grid x:Name="ViewHost" Grid.Row="1" Focusable="False"/>
        <!-- CP3 item 69 (renders 05, 06, 06b): the shell dims behind the Settings window,
             rgba(0,0,0,.84), faded in and out over 200 ms. -->
        <Border x:Name="DimLayer" Grid.RowSpan="2" Background="#D6000000" Opacity="0" Visibility="Collapsed" IsHitTestVisible="True"/>
    </Grid>
</Window>
