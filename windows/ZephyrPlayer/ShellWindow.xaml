<Window x:Class="ZephyrPlayer.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player" Icon="/ZephyrPlayer;component/assets/icon.ico"
        Width="1600" Height="1000" MinWidth="760" MinHeight="480"
        Background="#060607" ResizeMode="CanResize" WindowStartupLocation="Manual">
    <!-- The ONE top-level window of the app (2.0, P0-1/P0-2). Library and player are
         views swapped in place inside ViewHost; nothing hides one window to show another. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="#C9C9D1"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#B22A1B"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CaptionRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Caption bar 32 px #0A0A0C: icon 18 px + "Zephyr Player" 12 px Medium #C9C9D1 (render 01). -->
        <Border x:Name="CaptionBar" Background="#0A0A0C">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="CaptionIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Zephyr Player" Margin="10,0,0,0" FontSize="12" FontWeight="Medium" Foreground="#C9C9D1" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.AutomationId="CaptionMinimize">
                        <Path Data="M0,5.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.AutomationId="CaptionMaximize">
                        <Path x:Name="MaximizeGlyph" Data="M2,0.5 H8 A1.5,1.5 0 0 1 9.5,2 V8 A1.5,1.5 0 0 1 8,9.5 H2 A1.5,1.5 0 0 1 0.5,8 V2 A1.5,1.5 0 0 1 2,0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="OnCloseButton" ToolTip="Close" AutomationProperties.AutomationId="CaptionClose">
                        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Views stack here. Normally one child; during a library<->player switch the
             outgoing library stays drawn under the incoming view until the switch has
             something to show (see ShellWindow.ShowView). -->
        <Grid x:Name="ViewHost" Grid.Row="1" Focusable="False"/>
    </Grid>
</Window>
