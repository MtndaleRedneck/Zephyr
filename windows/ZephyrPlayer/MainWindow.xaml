<Window x:Class="ZephyrPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:libvlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Zephyr Player" Width="1920" Height="1080" Icon="/ZephyrPlayer;component/assets/icon.ico"
        Background="Black" MouseMove="OnMouseMove" PreviewKeyDown="OnPlayerKeyDown" MouseDoubleClick="OnVideoDoubleClick">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <!-- Every floating control lives inside VideoView.Content
         (WPF airspace), not over the VideoView. -->
    <!-- Black surface before the first frame: the VideoView default is the light
         system control color, which flashed light-gray on every playback start
         (round-7 S7-4). -->
    <libvlc:VideoView x:Name="Video" Background="Black">
        <libvlc:VideoView.Content>
            <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove">
                <Border x:Name="TopOverlay" VerticalAlignment="Top" Background="#551B1B1E" Padding="18,10"><DockPanel><Button x:Name="HomeButton" ToolTip="Back to Movies" Click="OnHome" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0" Padding="8"><Path Data="M16,4 L8,12 L16,20 M8,12 H23" Stroke="#F5F5F7" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform"/></Button><TextBlock Text="Zephyr Player" Foreground="#F5F5F7" VerticalAlignment="Center" Margin="14,0"/><TextBlock x:Name="MovieTitle" Foreground="#F5F5F7" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
                <Border x:Name="ControlBar" x:FieldModifier="public"
                        VerticalAlignment="Bottom" Margin="20"
                        Padding="22,14" CornerRadius="16"
                        Background="#BD1E1E22" BorderBrush="#35353B" BorderThickness="1" Opacity="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                          <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#FF9500" FontSize="13" VerticalAlignment="Center"/>
                          <Slider Style="{StaticResource PlaybackSlider}" x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" Foreground="#FF9500" PreviewMouseDown="OnSeekDown" PreviewMouseUp="OnSeekUp"/>
                          <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" Foreground="#F5F5F7" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="TotalText" Visibility="Collapsed" Text="0:00 total"/>
                        <Viewbox Grid.Row="3" Stretch="Uniform" StretchDirection="DownOnly"><Grid Width="900">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- default placement: volume LEFT, other icons RIGHT -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="VolumeButton" Width="34" Height="34" Padding="0" Click="OnMute"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Path x:Name="VolumeGlyph" Data="M2,10 v6 h4 l5,4 V6 l-5,4 Z M14,9 a4,4 0 0 1 0,8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Stretch="Uniform" Height="16" Width="16"/>
                                </Button>
                                <Slider Style="{StaticResource PlaybackSlider}" Foreground="#F5F5F7" x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Margin="6,0,0,0" ValueChanged="OnVolumeChanged"
                                        ToolTip="Volume (matches Windows)"/>
                                <TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}}" Foreground="#9696A0" VerticalAlignment="Center" Margin="6,0"/>
                            </StackPanel>
                            <StackPanel x:Name="CenterPlaybackControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <Button x:Name="SecondarySkipBackButton" ToolTip="Skip back" Width="54" Height="46" Padding="0" Click="OnSecondarySkipBack" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                  <Grid ClipToBounds="False">
                                    <Canvas Width="54" Height="46" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><RotateTransform x:Name="SecondaryBackSpin"/></Canvas.RenderTransform><Path x:Name="SecondarySkipBackIcon" Data="M46,17 Q27,-2 8,17 M8,17 L8,8 M8,17 L17,14" Stroke="#F5F5F7" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas><TextBlock x:Name="SecondarySkipBackLabel" Text="30" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                      </Grid>
                                </Button>
                                <Button x:Name="SkipBackButton" ToolTip="Primary skip backward" AutomationProperties.Name="Primary skip backward" Width="60" Height="60" Padding="0" Click="OnSkipBack"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Grid>
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform x:Name="SkipBackSpin" Angle="0"/></Grid.RenderTransform>
                                            <Path x:Name="SkipBackRing" Data="M33.41,35.40 A16.19,16.19 0 1 0 9.27,31.58" Stroke="#F5F5F7" StrokeThickness="3.9"/>
                                            <Path x:Name="SkipBackArrow" Data="M14.91,38.37 L12.58,28.06 L5.20,34.21 Z" Fill="#F5F5F7"/>
                                        </Grid>
                                        <TextBlock x:Name="SkipBackLabel" Text="10" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PlayPauseButton" Width="64" Height="64" Padding="0" Click="OnPlayPause"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0">
                                    <Grid>
                                        <Ellipse x:Name="PlayRing" Width="60" Height="60" Stroke="#F5F5F7" StrokeThickness="3" Fill="Transparent"/>
                                        <Path x:Name="PlayGlyph" Data="M26,20 L46,32 L26,44 Z" Fill="#F5F5F7"/>
                                        <Grid x:Name="PauseGlyph" Width="24" Height="24" Visibility="Collapsed">
                                            <Rectangle Width="6" Height="24" Fill="#F5F5F7" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                            <Rectangle Width="6" Height="24" Fill="#F5F5F7" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Button x:Name="SkipForwardButton" ToolTip="Primary skip forward" AutomationProperties.Name="Primary skip forward" Width="60" Height="60" Padding="0" Click="OnSkipForward"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Grid>
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform x:Name="SkipForwardSpin" Angle="0"/></Grid.RenderTransform>
                                            <Path x:Name="SkipForwardRing" Data="M12.59,35.40 A16.19,16.19 0 1 1 36.73,31.58" Stroke="#F5F5F7" StrokeThickness="3.9"/>
                                            <Path x:Name="SkipForwardArrow" Data="M31.09,38.37 L33.42,28.06 L40.80,34.21 Z" Fill="#F5F5F7"/>
                                        </Grid>
                                        <TextBlock x:Name="SkipForwardLabel" Text="10" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="SecondarySkipForwardButton" ToolTip="Skip forward" Width="54" Height="46" Padding="0" Click="OnSecondarySkipForward" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                  <Grid ClipToBounds="False">
                                    <Canvas Width="54" Height="46" RenderTransformOrigin="0.5,0.5"><Canvas.RenderTransform><RotateTransform x:Name="SecondaryForwardSpin"/></Canvas.RenderTransform><Path x:Name="SecondarySkipForwardIcon" Data="M8,17 Q27,-2 46,17 M46,17 L46,8 M46,17 L37,14" Stroke="#F5F5F7" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas><TextBlock x:Name="SecondarySkipForwardLabel" Text="30" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                      </Grid>
                                </Button>

                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CaptionsButton" Margin="0,0,8,0" Padding="6" Click="OnCaptions" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Subtitles">
                                    <Viewbox Width="24" Height="24"><Canvas Width="28" Height="28">
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5.7,5.0 H22.3 A1.7,1.7 0 0 1 24,6.7 V17.3 A1.7,1.7 0 0 1 22.3,19.0 H14.5 L7.4,24.8 L9.5,19.0 H5.7 A1.7,1.7 0 0 1 4,17.3 V6.7 A1.7,1.7 0 0 1 5.7,5.0 Z"/>
                                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7.2,9.0 H13.3 M14.7,9.0 H17.7 M19.1,9.0 H20.8 M7.2,12.0 H8.7 M10.1,12.0 H16.2 M17.6,12.0 H20.8 M7.2,15.0 H11.8 M13.2,15.0 H15.1 M16.5,15.0 H20.8"/>
                                    </Canvas></Viewbox>
                                </Button>
                                <Button x:Name="SpeedButton" Visibility="Collapsed" Margin="0,0,10,0" Padding="8,4" Click="OnSpeed"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <Grid><Path Data="M3,17 A9,9 0 1 1 21,17 M12,13 L17,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="24" Height="24" Stretch="Uniform"/><TextBlock x:Name="SpeedLabel" Visibility="Collapsed"/></Grid>
                                </Button>
                                <Button x:Name="SleepButton" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,4" Click="OnSleep"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <Grid><Path Data="M19,15 A8,8 0 1 1 9,3 A7,7 0 0 0 19,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="24" Height="24" Stretch="Uniform"/><TextBlock x:Name="SleepLabel" Visibility="Collapsed"/></Grid>
                                </Button>
                                <Button x:Name="FullscreenButton" Padding="6" Click="OnFullscreen" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Fullscreen">
                                    <Viewbox Width="24" Height="24"><Canvas Width="28" Height="28">
                                        <Path x:Name="FullscreenGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,9.8 V5.7 A1.7,1.7 0 0 1 5.7,4 H9.8 M18.2,4 H22.3 A1.7,1.7 0 0 1 24,5.7 V9.8 M24,18.2 V22.3 A1.7,1.7 0 0 1 22.3,24 H18.2 M4,18.2 V22.3 A1.7,1.7 0 0 0 5.7,24 H9.8"/>
                                    </Canvas></Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid></Viewbox>
                    </Grid>
                </Border>
            </Grid>
        </libvlc:VideoView.Content>
    </libvlc:VideoView>
</Window>
