<Window x:Class="ZephyrPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:libvlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Zephyr" Width="1920" Height="1080" Icon="/ZephyrPlayer;component/assets/icon.ico"
        Background="Black" MouseMove="OnMouseMove">
    <!-- Every floating control lives inside VideoView.Content
         (WPF airspace), not over the VideoView. -->
    <libvlc:VideoView x:Name="Video">
        <libvlc:VideoView.Content>
            <Grid x:Name="Overlay" Background="Transparent">
                <Border x:Name="PairBanner" x:FieldModifier="public" Visibility="Collapsed"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Background="#CC202124" CornerRadius="12" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="Pair with your phone" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PairCodeText" x:FieldModifier="public" Text="" Foreground="#F0C23E" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ControlBar" x:FieldModifier="public"
                        VerticalAlignment="Bottom" Margin="24"
                        Padding="16,10" CornerRadius="12"
                        Background="#CC202124" Opacity="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="SeekBar" Grid.Row="0"
                                Minimum="0" Maximum="1000" Value="0"
                                PreviewMouseDown="OnSeekDown" PreviewMouseUp="OnSeekUp"/>
                        <Grid Grid.Row="1" Margin="0,2,0,6">
                            <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#F0C23E" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TotalText" Text="of 0:00" Foreground="#9696A0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RemainingText" Text="-0:00" Foreground="White" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- default placement: volume LEFT, other icons RIGHT -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="VolumeButton" Width="34" Height="34" Padding="0" Click="OnMute"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Path x:Name="VolumeGlyph" Data="M2,10 v6 h4 l5,4 V6 l-5,4 Z M14,9 a4,4 0 0 1 0,8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Stretch="Uniform" Height="16" Width="16"/>
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Margin="6,0,0,0" ValueChanged="OnVolumeChanged"
                                        ToolTip="Volume (matches Windows)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="SpeedButton" Visibility="Collapsed" Margin="0,0,10,0" Padding="8,4" Click="OnSpeed"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpeedLabel" Text="1x" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold"/>
                                </Button>
                                <Button x:Name="SkipBackButton" Width="60" Height="60" Padding="0" Click="OnSkipBack"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Grid>
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform x:Name="SkipBackSpin" Angle="0"/></Grid.RenderTransform>
                                            <Ellipse x:Name="SkipBackRing" Width="46" Height="46" Stroke="#F5F5F7" StrokeThickness="2.5" StrokeDashArray="30 4"/>
                                            <Path x:Name="SkipBackArrow" Data="M24,2 L19,11 L29,11 Z" Fill="#F5F5F7"/>
                                        </Grid>
                                        <TextBlock x:Name="SkipBackLabel" Text="5" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PlayPauseButton" Width="72" Height="72" Padding="0" Click="OnPlayPause"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0">
                                    <Grid>
                                        <Ellipse x:Name="PlayRing" Width="64" Height="64" Stroke="#F5F5F7" StrokeThickness="3" Fill="Transparent"/>
                                        <Path x:Name="PlayGlyph" Data="M26,20 L46,32 L26,44 Z" Fill="#F5F5F7"/>
                                        <Grid x:Name="PauseGlyph" Visibility="Collapsed">
                                            <Rectangle Width="6" Height="24" Fill="#F5F5F7" HorizontalAlignment="Left" Margin="24,0,0,0"/>
                                            <Rectangle Width="6" Height="24" Fill="#F5F5F7" HorizontalAlignment="Right" Margin="0,0,24,0"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Button x:Name="SkipForwardButton" Width="60" Height="60" Padding="0" Click="OnSkipForward"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Grid>
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><RotateTransform x:Name="SkipForwardSpin" Angle="0"/></Grid.RenderTransform>
                                            <Ellipse x:Name="SkipForwardRing" Width="46" Height="46" Stroke="#F5F5F7" StrokeThickness="2.5" StrokeDashArray="30 4"/>
                                            <Path x:Name="SkipForwardArrow" Data="M24,2 L19,11 L29,11 Z" Fill="#F5F5F7"/>
                                        </Grid>
                                        <TextBlock x:Name="SkipForwardLabel" Text="30" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="SleepButton" Visibility="Collapsed" Margin="10,0,0,0" Padding="8,4" Click="OnSleep"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <TextBlock x:Name="SleepLabel" Text="zZ" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CaptionsButton" Content="CC" Margin="0,0,8,0" Click="OnCaptions" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                <Button x:Name="FullscreenButton" Content="full" Click="OnFullscreen" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </libvlc:VideoView.Content>
    </libvlc:VideoView>
</Window>
