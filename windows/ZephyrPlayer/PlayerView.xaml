<UserControl x:Class="ZephyrPlayer.PlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:libvlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:ZephyrPlayer"
        Background="Black" Focusable="False" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F5F5F7"
        MouseMove="OnMouseMove" MouseDoubleClick="OnVideoDoubleClick">
    <!-- 2.0: the player is a VIEW inside the one ShellWindow (no second top-level
         window). Leaving the player removes this view from the tree, which raises
         Unloaded, which makes LibVLCSharp hide its overlay window.
         CP2 (renders 02, 03, 04): floating bar card, real-size 3-column layout,
         in-overlay pop-ups (one open at a time), fullscreen pill, error state. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <!-- Bar, chip, row and text button styles live in Theme.xaml (shared with the Settings preview, CP3 item 73). -->
            <!-- Shared pop-up card (render 04 .pop): rgba(22,22,26,.94), 1 px rgba(255,255,255,.09),
                 radius 14, padding 14, shadow 0 24 60 rgba(0,0,0,.6). The HTML's backdrop blur is a
                 solid see-through fill here (Instinct correction, section 9). -->
            <Style x:Key="ZPopupCard" TargetType="Border">
                <Setter Property="Background" Value="#F016161A"/>
                <Setter Property="BorderBrush" Value="#17FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="TextBlock.Foreground" Value="#F5F5F7"/>
                <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="60" ShadowDepth="24" Direction="270" Opacity="0.6" Color="Black"/></Setter.Value></Setter>
            </Style>
            <Style x:Key="ZPopupHeader" TargetType="Grid">
                <Setter Property="Margin" Value="4,2,4,12"/>
            </Style>
            <Style x:Key="ZPopupSep" TargetType="Border">
                <Setter Property="Height" Value="1"/><Setter Property="Background" Value="#12FFFFFF"/><Setter Property="Margin" Value="2,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Every floating control lives inside VideoView.Content (WPF airspace), not over
         the VideoView. Black surface before the first frame (round-7 S7-4). -->
    <libvlc:VideoView x:Name="Video" Background="Black">
        <libvlc:VideoView.Content>
            <Grid x:Name="Overlay" Background="#01000000" MouseMove="OnMouseMove" PreviewMouseDown="OnOverlayMouseDown" SizeChanged="OnOverlaySizeChanged">
                <!-- Loading state from navigation until the start settles (black, spinner, title). -->
                <Grid x:Name="LoadingPanel" Background="#060607" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid x:Name="Spinner" Width="44" Height="44" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform x:Name="SpinnerTurn"/></Grid.RenderTransform>
                            <Ellipse Stroke="#26FFFFFF" StrokeThickness="3"/>
                            <Path Data="M22,1.5 A20.5,20.5 0 0 1 42.5,22" Stroke="#FF9500" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock x:Name="LoadingTitle" Foreground="#F5F5F7" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        <TextBlock x:Name="LoadingDetail" Text="Opening..." Foreground="#8E8E98" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"/>
                    </StackPanel>
                </Grid>
                <!-- Error state (item 68): message + "Back to library" + "Try again". Not pictured
                     in the renders; built only from their tokens (#060607, 15 px SemiBold title,
                     12.5 px #8E8E98, .btn / .btn.or buttons). -->
                <Grid x:Name="ErrorPanel" Background="#060607" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Viewbox Width="36" Height="36" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M12,7.6 V13 M12,16.3 V16.4" Stroke="#FF9500" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                        <TextBlock x:Name="ErrorTitle" Foreground="#F5F5F7" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        <TextBlock x:Name="ErrorMessage" Foreground="#8E8E98" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button x:Name="ErrorBackButton" Style="{StaticResource ZTextButton}" Content="Back to library" Click="OnHome" AutomationProperties.Name="Back to library"/>
                            <Button x:Name="ErrorRetryButton" Style="{StaticResource ZTextButton}" Tag="or" Margin="10,0,0,0" Content="Try again" Click="OnTryAgain" AutomationProperties.Name="Try again"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- Fullscreen soft gradients (render 03): bottom 220 px 0 -> rgba(0,0,0,.55);
                     they fade with the bar. -->
                <Border x:Name="BottomGradient" VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#8C000000" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <!-- Top overlay (render 02): 120 px gradient rgba(0,0,0,.7) -> 0, padding 16 20,
                     back 32 px, title 15 SemiBold, meta 12.5 #9C9CA6. Fullscreen (render 03): 140 px
                     rgba(0,0,0,.62) -> 0, back at 24/22 with its own dark fill, no meta. -->
                <Border x:Name="TopOverlay" VerticalAlignment="Top" Height="120" Padding="20,16,20,0">
                    <Border.Background><LinearGradientBrush x:Name="TopGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop x:Name="TopGradientStart" Color="#B3000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="HomeButton" ToolTip="Back to library" AutomationProperties.Name="Back to library" Click="OnHome" Focusable="False" Cursor="Hand" Width="32" Height="32">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid><Border x:Name="Bg" CornerRadius="8" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="Hl" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/><Border x:Name="Pr" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/></Grid>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0.0706" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="Opacity" To="0.0548" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" EasingFunction="{StaticResource ZEase}"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Tag><SolidColorBrush Color="#14FFFFFF"/></Button.Tag>
                            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M19,12 H5 M11,6 L5,12 L11,18" Stroke="#D6D6DD" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                        </Button>
                        <TextBlock x:Name="MovieTitle" Foreground="#F5F5F7" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" LineHeight="32" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="900">
                            <TextBlock.Effect><DropShadowEffect x:Name="TitleShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0" Color="Black"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="MovieMeta" Foreground="#9C9CA6" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
                <!-- One-line notice (for example "Subtitles: English"). -->
                <Border x:Name="Osd" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,76,0,0" Background="#F016161A" BorderBrush="#17FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,7" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="OsdText" Foreground="#F5F5F7" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <!-- The bar: a floating card, NOT a full-width scrim (render 02). Inset 20, radius 16,
                     padding 10 18 9, rgba(12,12,15,.74), 1 px rgba(255,255,255,.085), shadow 0 18 50
                     rgba(0,0,0,.55). Fullscreen: the same content laid out at up to 1000 px and drawn
                     at 0.78 (render 03), clamped to the screen (Instinct U2). -->
                <!-- CP3 item 73: the bar is its own control (PlayerBar), so Settings can show the
                     REAL bar as its live preview. Its parts keep their names in this view (see
                     PlayerView.BindBar), so FindName and every handler work as before. -->
                <local:PlayerBar x:Name="Bar"/>
                <!-- Pop-ups (render 04), anchored above their own button, one open at a time; the
                     render shows all three side by side for review only. Bottom edge: 20 px above
                     the bar's top (= 130 px above the window bottom when windowed). -->
                <Border x:Name="SubtitlesPopup" Style="{StaticResource ZPopupCard}" Width="300">
                    <StackPanel>
                        <Grid Style="{StaticResource ZPopupHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Stroke="#F5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M6,5 H18 A3,3 0 0 1 21,8 V15 A3,3 0 0 1 18,18 H6 A3,3 0 0 1 3,15 V8 A3,3 0 0 1 6,5 Z M8,18 L6.5,21 L11,18 M7,10.5 H12 M14.5,10.5 H17 M7,14 H9.5 M12,14 H17"/></Canvas></Viewbox>
                                <TextBlock Text="Subtitles" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="SubtitleTrackList"/>
                        <Button x:Name="AddSubtitleRow" Style="{StaticResource ZPopupRow}" Foreground="#FF9500" Click="OnAddSubtitleRow" AutomationProperties.Name="Add subtitle file...">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M12,5 V19 M5,12 H19" Stroke="#FF9500" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                                <TextBlock Text="Add subtitle file…" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource ZPopupSep}"/>
                        <Grid Margin="6,4">
                            <TextBlock Text="Size" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel x:Name="SubtitleSizeChips" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SubSizeS" Style="{StaticResource ZChip}" Height="26" Padding="10,0" Content="S" Click="OnSubtitleSize" Tag="" ToolTip="Small - applies after you quit Zephyr Player (tray menu) and open it again"/>
                                <Button x:Name="SubSizeM" Style="{StaticResource ZChip}" Height="26" Padding="10,0" Margin="6,0,0,0" Content="M" Click="OnSubtitleSize" Tag="on" ToolTip="Medium - applies after you quit Zephyr Player (tray menu) and open it again"/>
                                <Button x:Name="SubSizeL" Style="{StaticResource ZChip}" Height="26" Padding="10,0" Margin="6,0,0,0" Content="L" Click="OnSubtitleSize" Tag="" ToolTip="Large - applies after you quit Zephyr Player (tray menu) and open it again"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="6,8,6,2">
                            <TextBlock Text="Delay" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SubDelayMinus" Style="{StaticResource ZBoxButton}" Click="OnSubtitleDelayMinus" ToolTip="Subtitles 0.1 s earlier" AutomationProperties.Name="Subtitle delay minus">
                                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M5,12 H19" Stroke="#D6D6DD" StrokeThickness="1.6" StrokeStartLineCap="Round"/></Canvas></Viewbox>
                                </Button>
                                <TextBlock x:Name="SubDelayText" Text="+0.0 s" FontSize="13" Width="44" TextAlignment="Center" Margin="8,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                <Button x:Name="SubDelayPlus" Style="{StaticResource ZBoxButton}" Click="OnSubtitleDelayPlus" ToolTip="Subtitles 0.1 s later" AutomationProperties.Name="Subtitle delay plus">
                                    <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M12,5 V19 M5,12 H19" Stroke="#D6D6DD" StrokeThickness="1.6" StrokeStartLineCap="Round"/></Canvas></Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="SpeedPopup" Style="{StaticResource ZPopupCard}" Width="330">
                    <StackPanel>
                        <Grid Style="{StaticResource ZPopupHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Stroke="#F5F5F7" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.2,17.5 A9,9 0 1 1 19.8,17.5 M12,13.2 L16,9 M12,5.5 V6.9 M6.4,8 L7.4,9 M17.6,8 L16.6,9 M4.6,13 H6 M18,13 H19.4"/><Path Fill="#F5F5F7" Data="M10.6,13.6 A1.4,1.4 0 1 1 13.4,13.6 A1.4,1.4 0 1 1 10.6,13.6 Z"/></Canvas></Viewbox>
                                <TextBlock Text="Playback speed" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SpeedHeaderValue" Text="1×" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF9500" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <UniformGrid x:Name="SpeedChips" Columns="3" Margin="-4">
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="0.5×" Tag="" Click="OnSpeedChip"/>
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="0.75×" Tag="" Click="OnSpeedChip"/>
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="Normal" Tag="" Click="OnSpeedChip"/>
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="1.25×" Tag="" Click="OnSpeedChip"/>
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="1.5×" Tag="" Click="OnSpeedChip"/>
                            <Button Style="{StaticResource ZChip}" Margin="4" Padding="0" Content="2×" Tag="" Click="OnSpeedChip"/>
                        </UniformGrid>
                        <Border Style="{StaticResource ZPopupSep}" Margin="2,14,2,12"/>
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="0.25×" FontSize="12" Foreground="#8E8E98" VerticalAlignment="Center"/>
                            <Slider x:Name="SpeedSlider" Grid.Column="1" Margin="10,0" Style="{StaticResource ZVolumeSlider}" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnSpeedSliderChanged"/>
                            <TextBlock Grid.Column="2" Text="4×" FontSize="12" Foreground="#8E8E98" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="SleepPopup" Style="{StaticResource ZPopupCard}" Width="290">
                    <StackPanel>
                        <Grid Style="{StaticResource ZPopupHeader}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Stroke="#F5F5F7" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M19.5,14.6 A8,8 0 0 1 9.4,4.5 A8,8 0 1 0 19.5,14.6 Z"/></Canvas></Viewbox>
                                <TextBlock Text="Sleep timer" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SleepHeaderValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#FF9500" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                        <StackPanel x:Name="SleepRows">
                            <Button Style="{StaticResource ZPopupRow}" Content="Off" Tag="sel" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="15 minutes" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="30 minutes" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="45 minutes" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="1 hour" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="1 hour 30" Click="OnSleepRow"/>
                            <Button Style="{StaticResource ZPopupRow}" Content="End of this movie" Click="OnSleepRow"/>
                        </StackPanel>
                        <Border Style="{StaticResource ZPopupSep}"/>
                        <TextBlock Text="Pauses the movie when time is up" FontSize="12" Foreground="#8E8E98" Margin="6,6,6,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </libvlc:VideoView.Content>
    </libvlc:VideoView>
</UserControl>
