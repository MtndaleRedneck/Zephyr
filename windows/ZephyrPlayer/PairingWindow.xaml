<Window x:Class="ZephyrPlayer.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zephyr Player - Pair your phone" Width="560" Height="600"
        Background="#1B1B1E" Icon="/ZephyrPlayer;component/assets/icon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#26262D"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9500"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9696A0"/>
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
            <Setter Property="Foreground" Value="#1B1B1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,16">

        <!-- Pair new phone -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Pair new phone" Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="PhoneNameBox" VerticalContentAlignment="Center"
                                 Background="#1B1B1E" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 Padding="10,7" FontSize="13" MaxLength="40"
                                 TextChanged="OnPhoneNameChanged"/>
                        <!-- Placeholder, not real text (review should-fix 1): an untouched
                             box pairs as "My phone"; typing replaces it, no deleting first. -->
                        <TextBlock x:Name="PhoneNameHint" Text="My phone" IsHitTestVisible="False"
                                   Foreground="#6E6E76" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource OrangeButton}" Content="Pair" Click="OnPair" Margin="12,0,0,0"/>
                </Grid>
                <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock x:Name="PairCodeText" Text="" Foreground="{StaticResource OrangeBrush}"
                               FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="ExpiresText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <Button Style="{StaticResource LinkButton}" Content="Cancel" FontSize="12" Click="OnCancelCode"/>
                    </StackPanel>
                    <TextBlock x:Name="ThisPcText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Paired phones -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Paired phones" Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="NoPhonesText" Text="No phones paired yet." Foreground="{StaticResource MutedBrush}" FontSize="12" Visibility="Collapsed"/>
                <ItemsControl x:Name="PhoneList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Remove" FontSize="12"
                                        Tag="{Binding Token}" Click="OnRemovePhone"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Text="Ready for your phone" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
