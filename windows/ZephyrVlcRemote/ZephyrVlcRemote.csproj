<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZephyrVlcRemote</AssemblyName>
    <ApplicationIcon>Assets\zephyr-vlc-remote.ico</ApplicationIcon>
    <Version>1.0.0.0</Version>
    <Description>Zephyr VLC Remote for Windows: VLC control on this PC for the Zephyr Android app.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- CI-only evidence hooks stay out of the shipped binary: passing -p:CaptureHook=true
       APPENDS the constant instead of clobbering the project's DefineConstants (round-6 S6-7). -->
  <PropertyGroup Condition="'$(CaptureHook)' == 'true'">
    <DefineConstants>$(DefineConstants);CI_CAPTURE_HOOK;PAIR_CODE_HOOK;WINDOW_SHOT_HOOK</DefineConstants>
  </PropertyGroup>
</Project>
